# ---------------------------------------------------------------
# Smart Canteen Token System - environment configuration
# Copy this file to ".env" and edit. EVERYTHING here is optional:
# the app runs fully in local mode with no .env at all.
# ---------------------------------------------------------------

# --- Database ---
# DB_PATH=data/canteen.db

# --- LLM (optional, used only for natural-language ordering) ---
# LLM_PROVIDER: none | anthropic | openai
#   "openai" works with any OpenAI-compatible API (OpenAI, Groq, Ollama, ...)
LLM_PROVIDER=none
LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=15

# --- Kitchen / queue settings ---
KITCHEN_STATIONS=2
DUPLICATE_WINDOW_SECONDS=60
MAX_ACTIVE_ORDERS_PER_STUDENT=3

# --- Staff dashboard PIN ---
STAFF_PIN=1234

# --- Email notifications (optional) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_USE_TLS=true
